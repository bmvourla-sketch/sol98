# Copy to .env.local and fill in your own values.

# Solana RPC — mainnet by default, devnet for testing without real funds.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Treasury wallet that receives every pixel purchase (REQUIRED for live sales).
NEXT_PUBLIC_TREASURY_ADDRESS=

# $PIXEL98 mint after the Pump.fun launch (empty → hijack burns are simulated).
NEXT_PUBLIC_PIXEL98_MINT=

# Centralized board state endpoint (default: same-origin /api/pixels).
NEXT_PUBLIC_PIXELS_API_URL=/api/pixels

# ── Durable board store (optional, Vercel production) ──────────────
# When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, the board persists to
# Supabase instead of the local file. See README for the table SQL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# PIXELS_TABLE=pixels
