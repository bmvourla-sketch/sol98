# Copy to .env.local and fill in your own values.

# Solana RPC — mainnet by default, devnet for testing without real funds.
# Used by the CLIENT (wallet-adapter) to send transactions.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Server-only RPC used to VERIFY signatures in the API routes. Optional —
# falls back to NEXT_PUBLIC_SOLANA_RPC_URL when unset. Point this at a
# dedicated provider (Helius/Triton/QuickNode) in production so verification
# traffic doesn't compete with the public endpoint the browser uses.
SOLANA_RPC_URL=

# Treasury wallet that receives every pixel purchase (REQUIRED for live sales).
NEXT_PUBLIC_TREASURY_ADDRESS=

# $PIXEL98 mint after the Pump.fun launch (empty → hijack is the documented
# pre-launch "simulated" mode: free, but wallet-signed and rate-limited).
NEXT_PUBLIC_PIXEL98_MINT=

# Centralized board state endpoint (default: same-origin /api/pixels).
NEXT_PUBLIC_PIXELS_API_URL=/api/pixels

# ── Durable store (optional, Vercel production) ─────────────────────
# When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, the board, the
# purchased-documents list, AND the replay-protection signature log all
# persist to Supabase instead of local files. See README for the table SQL —
# all three tables are required together.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# PIXELS_TABLE=pixels
# DOCUMENTS_TABLE=documents
# SIGNATURES_TABLE=used_signatures
